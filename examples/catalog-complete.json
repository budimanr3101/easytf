            "depends_on": [],
            "tags": {}
          },
          "s3_bucket_policy": {
            "kind": "aws_s3_bucket_policy",
            "configuration": {
              "bucket": "sample-bucket",
              "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"s3:*\", \"Resource\": [\"arn:aws:s3:::replace-with-globally-unique-catalog-bucket\", \"arn:aws:s3:::replace-with-globally-unique-catalog-bucket/*\"], \"Condition\": {\"Bool\": {\"aws:SecureTransport\": \"false\"}}}]}"
            },
            "links": {
              "/bucket": [
                {
                  "resource_key": "s3_bucket",
                  "output": "id"
                }
              ]
            },
            "depends_on": [],
            "tags": {}
          },
